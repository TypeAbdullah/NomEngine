# General
APP_NAME=NomEngine
APP_VERSION=1.0.0
ENVIRONMENT=development
SECRET_KEY=nomengine-super-secret-key-change-in-production
DEBUG=false

# Database Configuration
# Local SQLite fallback: sqlite+aiosqlite:///./nomengine.db
# PostgreSQL: postgresql+asyncpg://postgres:postgrespassword@localhost:5432/nomengine
DATABASE_URL=sqlite+aiosqlite:///./nomengine.db

# Redis Cache & Queue
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true

# Crawler Configuration
CRAWLER_USER_AGENT=NomEngineBot/1.0 (+https://nomengine.local/bot; search-crawler@nomengine.local)
CRAWLER_MAX_CONCURRENT_REQUESTS=50
CRAWLER_MAX_REQUESTS_PER_DOMAIN=2
CRAWLER_CRAWL_DELAY_DEFAULT=1.0
CRAWLER_MAX_PAGE_DEPTH=5
CRAWLER_MAX_RESPONSE_SIZE=5242880
CRAWLER_REQUEST_TIMEOUT=10.0
CRAWLER_MAX_RETRIES=3
CRAWLER_MAX_DOCUMENTS=10000

# Ranking Weights
WEIGHT_BM25=0.40
WEIGHT_TITLE=0.25
WEIGHT_PHRASE=0.15
WEIGHT_PAGERANK=0.10
WEIGHT_FRESHNESS=0.05
WEIGHT_QUALITY=0.05
PENALTY_SPAM=0.50

# Frontend Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000/api
